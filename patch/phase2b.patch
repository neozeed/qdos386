diff --git a/tests/a16/r20c.c b/tests/a16/r20c.c
new file mode 100644
index 0000000..fdcb623
--- /dev/null
+++ b/tests/a16/r20c.c
@@ -0,0 +1,169 @@
+/* R20C - Apollo 16 Phase 2B: write coherence through the sector cache.  Internal test program.
+ *   R20C W   read -> write -> read on the same sectors, truncate and recreate, cluster reuse, partial overwrite and
+ *            extend.  Every read-back is checked byte for byte against what was last written.
+ *   R20C K   readback: the file RB.BIN left by an earlier boot (run W, then reboot on its final image) must read back.
+ * Prints "R20C W PASS" or "R20C W FAIL step=...".
+ */
+#include <stdio.h>
+#include "qdos386.h"
+
+#define T_SMP 0x3Eu
+
+static unsigned char wbuf[4096];
+static unsigned char ebuf[8192];
+
+static unsigned int val(unsigned long i, unsigned int salt)
+{
+	return (unsigned int) (((i * 37ul) + (unsigned long) salt * 101ul + ((i >> 8) * 11ul)) & 0xffu);
+}
+
+static int put(const char *name, unsigned long n, unsigned int salt, unsigned int flags)
+{
+	int ch, rc;
+	unsigned long i;
+
+	for (i = 0; i < n; i++)
+		wbuf[i < sizeof(wbuf) ? i : 0] = (unsigned char) val(i, salt);
+	ch = qd_open_ex(name, flags);
+	if (ch <= 0)
+		return -1;
+	rc = qd_write_all(ch, wbuf, (unsigned int) n);
+	qd_close(ch);
+	return rc == (int) n ? 0 : -2;
+}
+
+/* Compare the whole file with the expected image: the first n bytes of exp[]. */
+static int get(const char *name, const unsigned char *exp, unsigned long n)
+{
+	int ch, r, bad = 0;
+	unsigned char b[QD_READ_MAX];
+	unsigned long pos = 0, k;
+
+	ch = qd_open(name);
+	if (ch <= 0)
+		return -1;
+	if (qd_fsize(ch) != (long) n) {
+		printf("R20C size of %s is %ld, want %lu\n", name, qd_fsize(ch), n);
+		bad++;
+	}
+	while (pos < n) {
+		r = qd_read(ch, b, QD_READ_MAX);
+		if (r <= 0)
+			break;
+		for (k = 0; k < (unsigned long) r; k++)
+			if (pos + k < n && b[k] != exp[pos + k]) {
+				if (bad < 4)
+					printf("R20C %s byte %lu got %u want %u\n", name, pos + k, (unsigned int) b[k],
+					       (unsigned int) exp[pos + k]);
+				bad++;
+			}
+		pos += (unsigned long) r;
+	}
+	qd_close(ch);
+	if (pos != n)
+		bad++;
+	return bad;
+}
+
+static void fillexp(unsigned char *e, unsigned long n, unsigned int salt)
+{
+	unsigned long i;
+
+	for (i = 0; i < n; i++)
+		e[i] = (unsigned char) val(i, salt);
+}
+
+static int run_w(void)
+{
+	int bad = 0;
+	unsigned char exp[8192];
+	int ch;
+	unsigned long i;
+
+	qd_remove("WIN1:/CW.BIN");
+	qd_remove("WIN1:/CW2.BIN");
+	qd_remove("WIN1:/CW3.BIN");
+
+	/* 1. create and read back (the reads populate the cache) */
+	if (put("WIN1:/CW.BIN", 4096, 1, QD_O_WRITE | QD_O_CREATE | QD_O_TRUNC) != 0) {
+		printf("R20C W FAIL step=create\n");
+		return 1;
+	}
+	fillexp(exp, 4096, 1);
+	if (get("WIN1:/CW.BIN", exp, 4096) != 0) { printf("R20C W FAIL step=read1\n"); return 1; }
+	if (get("WIN1:/CW.BIN", exp, 4096) != 0) { printf("R20C W FAIL step=read1b\n"); return 1; }
+
+	/* 2. rewrite in place with a new salt (truncate + rewrite): read after write must see the new data */
+	if (put("WIN1:/CW.BIN", 4096, 2, QD_O_WRITE | QD_O_TRUNC) != 0) { printf("R20C W FAIL step=rewrite\n"); return 1; }
+	fillexp(exp, 4096, 2);
+	bad += get("WIN1:/CW.BIN", exp, 4096);
+	if (bad) { printf("R20C W FAIL step=stale-after-rewrite bad=%d\n", bad); return 1; }
+
+	/* 3. partial overwrite at offset 1000 (crosses a sector boundary), then read back */
+	ch = qd_open_ex("WIN1:/CW.BIN", QD_O_WRITE);
+	if (ch <= 0 || qd_seek(ch, 1000ul) < 0) { printf("R20C W FAIL step=seek\n"); return 1; }
+	for (i = 0; i < 300; i++)
+		wbuf[i] = (unsigned char) val(i, 3);
+	if (qd_write_all(ch, wbuf, 300u) != 300) { printf("R20C W FAIL step=partial\n"); qd_close(ch); return 1; }
+	qd_close(ch);
+	for (i = 0; i < 300; i++)
+		exp[1000 + i] = (unsigned char) val(i, 3);
+	bad += get("WIN1:/CW.BIN", exp, 4096);
+	if (bad) { printf("R20C W FAIL step=stale-after-partial bad=%d\n", bad); return 1; }
+
+	/* 4. remove, then create another file: its clusters are the ones just freed (cluster reuse) */
+	if (qd_remove("WIN1:/CW.BIN") != 0) { printf("R20C W FAIL step=remove\n"); return 1; }
+	if (put("WIN1:/CW2.BIN", 4096, 4, QD_O_WRITE | QD_O_CREATE | QD_O_TRUNC) != 0) { printf("R20C W FAIL step=create2\n"); return 1; }
+	fillexp(exp, 4096, 4);
+	bad += get("WIN1:/CW2.BIN", exp, 4096);
+	bad += get("WIN1:/CW2.BIN", exp, 4096);
+	if (bad) { printf("R20C W FAIL step=reuse bad=%d\n", bad); return 1; }
+
+	/* 5. extend with zeros (truncate to 8192 on a write channel), then the old part must still be intact */
+	ch = qd_open_ex("WIN1:/CW2.BIN", QD_O_WRITE);
+	if (ch <= 0 || qd_truncate(ch, 8192ul) != 0) { printf("R20C W FAIL step=extend\n"); return 1; }
+	qd_close(ch);
+	{
+		unsigned char e2[8192];
+		unsigned long k;
+
+		for (k = 0; k < 8192; k++)
+			e2[k] = k < 4096 ? (unsigned char) val(k, 4) : 0;
+		bad += get("WIN1:/CW2.BIN", e2, 8192);
+	}
+	if (bad) { printf("R20C W FAIL step=extend-check bad=%d\n", bad); return 1; }
+
+	/* 6. a third file, then remove both: nothing from them may survive in the cache as data of a new file */
+	if (put("WIN1:/CW3.BIN", 2048, 5, QD_O_WRITE | QD_O_CREATE | QD_O_TRUNC) != 0) { printf("R20C W FAIL step=create3\n"); return 1; }
+	fillexp(exp, 2048, 5);
+	bad += get("WIN1:/CW3.BIN", exp, 2048);
+	if (bad) { printf("R20C W FAIL step=create3-check\n"); return 1; }
+	qd_remove("WIN1:/CW2.BIN");
+	qd_remove("WIN1:/CW3.BIN");
+
+	/* 7. the readback file for the reboot check: 3000 bytes of salt 9 */
+	if (put("WIN1:/RB.BIN", 3000, 9, QD_O_WRITE | QD_O_CREATE | QD_O_TRUNC) != 0) { printf("R20C W FAIL step=rb\n"); return 1; }
+	fillexp(exp, 3000, 9);
+	bad += get("WIN1:/RB.BIN", exp, 3000);
+	printf("%s bad=%d\n", bad == 0 ? "R20C W PASS" : "R20C W FAIL", bad);
+	return bad != 0;
+}
+
+static int run_k(void)
+{
+	unsigned char exp[3000];
+	int bad;
+
+	fillexp(exp, 3000, 9);
+	bad = get("WIN1:/RB.BIN", exp, 3000);
+	printf("%s bad=%d\n", bad == 0 ? "R20C K PASS" : "R20C K FAIL", bad);
+	return bad != 0;
+}
+
+int main(int argc, char **argv)
+{
+	qtrap(T_SMP, 1u, (unsigned int) qd_self(), 0u);
+	if (argc >= 2 && argv[1][0] == 'K')
+		return run_k();
+	return run_w();
+}
diff --git a/tests/a16/r20d.c b/tests/a16/r20d.c
new file mode 100644
index 0000000..d7b61a0
--- /dev/null
+++ b/tests/a16/r20d.c
@@ -0,0 +1,17 @@
+/* R20D - Apollo 16 Phase 2B: waits R20D_WAIT timer ticks, then prints the cache state dump (R20_STAT_DUMP).  Test. */
+#include <stdio.h>
+#include "qdos386.h"
+#define T_STAT 0x45u
+#define QT_SUSPEND_T 0x08u
+#define R20_STAT_DUMP 35u
+#ifndef R20D_WAIT
+#define R20D_WAIT 3000
+#endif
+int main(void)
+{
+	int n;
+	qtrap(QT_SUSPEND_T, (unsigned int) R20D_WAIT, 0u, 0u);
+	n = qtrap(T_STAT, R20_STAT_DUMP, 0u, 0u);
+	printf("R20D DUMP done entries=%d\n", n);
+	return 0;
+}
diff --git a/tests/a16/r20g.c b/tests/a16/r20g.c
new file mode 100644
index 0000000..9965d91
--- /dev/null
+++ b/tests/a16/r20g.c
@@ -0,0 +1,156 @@
+/* R20G - Apollo 16 Phase 2B: cache workloads.  Internal test program, not a public API.
+ * The file WIN1:/PAT2.BIN (1572864 bytes, P(i) = (i*37 + (i>>8)*11 + (i>>16)) & 0xff) is read in 256-byte calls,
+ * pinned to CPU 0, two passes per run:
+ *   R20G_KIND 1  stream: the whole file, sequentially, twice (larger than the cache: streaming thrashes an LRU-like cache)
+ *   R20G_KIND 2  small:  1000 random reads inside the first 64 KiB, twice (a small constant working set)
+ *   R20G_KIND 3  large:  1500 random reads over the whole file, twice (a working set larger than the cache)
+ * Every byte is verified.  Each pass prints its ticks and, under an R20 kernel, the cache counter deltas (under R18 the
+ * counter calls return -1 and the deltas are meaningless).
+ */
+#include <stdio.h>
+#include "qdos386.h"
+
+#define T_SMP   0x3Eu
+#define T_TICKS 0x20u
+#define T_STAT  0x45u
+#define FILE_N  1572864ul
+#define SMALL_N 65536ul
+#define NAME    "WIN1:/PAT2.BIN"
+
+#ifndef R20G_KIND
+#define R20G_KIND 2
+#endif
+
+/* R20 stat indices (kernel/r20w.h): hit, miss, fill, restart, coalesced, evict, nospace, ide reads, cache used */
+static const int sidx[9] = { 13, 14, 15, 23, 24, 25, 26, 27, 32 };
+static const char *snam[9] = { "hit", "miss", "fill", "restart", "coal", "evict", "nospace", "ide", "used" };
+
+static unsigned int pat(unsigned long i)
+{
+	return (unsigned int) (((i * 37ul) + ((i >> 8) * 11ul) + (i >> 16)) & 0xffu);
+}
+
+static unsigned long bad = 0;
+
+static void check(const unsigned char *buf, int n, unsigned long pos)
+{
+	int k;
+
+	for (k = 0; k < n; k++)
+		if (buf[k] != pat(pos + (unsigned long) k)) {
+			bad++;
+			if (bad <= 4)
+				printf("R20G mismatch at %lu\n", pos + (unsigned long) k);
+		}
+}
+
+static void snap(int *v)
+{
+	int i;
+
+	for (i = 0; i < 9; i++)
+		v[i] = qtrap(T_STAT, (unsigned int) sidx[i], 0u, 0u);
+}
+
+static void report(int pass, const char *what, unsigned long calls, unsigned long bytes, unsigned int t0,
+		   unsigned int t1, const int *a, const int *b)
+{
+	int i;
+
+	printf("R20G %s pass=%d calls=%lu bytes=%lu bad=%lu t0=%u t1=%u ticks=%u\n", what, pass, calls, bytes, bad, t0,
+	       t1, t1 - t0);
+	printf("R20G %s pass=%d", what, pass);
+	for (i = 0; i < 9; i++) {
+		if (i == 8)
+			printf(" %s=%d", snam[i], b[i]);
+		else
+			printf(" %s=%d", snam[i], b[i] - a[i]);
+	}
+	printf("\n");
+}
+
+static int pass_stream(int ch, int p)
+{
+	unsigned char buf[QD_READ_MAX];
+	unsigned long pos = 0, calls = 0;
+	unsigned int t0, t1;
+	int a[9], b[9], r;
+
+	if (p > 1)
+		qd_seek(ch, 0);
+	snap(a);
+	t0 = (unsigned int) qtrap(T_TICKS, 0u, 0u, 0u);
+	while (pos < FILE_N) {
+		r = qd_read(ch, buf, QD_READ_MAX);
+		if (r <= 0) {
+			printf("R20G short read %d at %lu\n", r, pos);
+			bad++;
+			break;
+		}
+		check(buf, r, pos);
+		pos += (unsigned long) r;
+		calls++;
+	}
+	t1 = (unsigned int) qtrap(T_TICKS, 0u, 0u, 0u);
+	snap(b);
+	report(p, "stream", calls, pos, t0, t1, a, b);
+	return pos == FILE_N ? 0 : 1;
+}
+
+static int pass_random(int ch, int p, unsigned long span, unsigned long n)
+{
+	unsigned char buf[QD_READ_MAX];
+	unsigned long seed = 4242ul + (unsigned long) p * 7ul, pos, bytes = 0, calls = 0, k;
+	unsigned int t0, t1;
+	int a[9], b[9], r;
+
+	snap(a);
+	t0 = (unsigned int) qtrap(T_TICKS, 0u, 0u, 0u);
+	for (k = 0; k < n; k++) {
+		seed = (seed * 1103515245ul + 12345ul) & 0x7fffffffu;
+		pos = seed % span;
+		if (pos + QD_READ_MAX > FILE_N)
+			pos = FILE_N - QD_READ_MAX;
+		if (qd_seek(ch, pos) < 0) {
+			bad++;
+			continue;
+		}
+		r = qd_read(ch, buf, QD_READ_MAX);
+		if (r != QD_READ_MAX) {
+			printf("R20G short random read %d at %lu\n", r, pos);
+			bad++;
+			continue;
+		}
+		check(buf, r, pos);
+		bytes += (unsigned long) r;
+		calls++;
+	}
+	t1 = (unsigned int) qtrap(T_TICKS, 0u, 0u, 0u);
+	snap(b);
+	report(p, R20G_KIND == 2 ? "small" : "large", calls, bytes, t0, t1, a, b);
+	return bad == 0 ? 0 : 1;
+}
+
+int main(void)
+{
+	int ch, p, rc = 0;
+
+	qtrap(T_SMP, 1u, (unsigned int) qd_self(), 0u);   /* pinned to CPU 0; the storage worker runs elsewhere */
+	ch = qd_open(NAME);
+	if (ch <= 0) {
+		printf("R20G FAIL open rc=%d\n", ch);
+		return 1;
+	}
+	for (p = 1; p <= 2; p++) {
+#if R20G_KIND == 1
+		rc |= pass_stream(ch, p);
+#elif R20G_KIND == 2
+		rc |= pass_random(ch, p, SMALL_N, 1000ul);
+#else
+		rc |= pass_random(ch, p, FILE_N, 1500ul);
+#endif
+	}
+	qd_close(ch);
+	printf("%s bad=%lu\n", (rc == 0 && bad == 0) ? "R20G PASS" : "R20G FAIL", bad);
+	return rc;
+}
diff --git a/tests/a16/r20k.c b/tests/a16/r20k.c
new file mode 100644
index 0000000..9b4acfd
--- /dev/null
+++ b/tests/a16/r20k.c
@@ -0,0 +1,25 @@
+/* R20K - Apollo 16 Phase 2B: process termination during cache I/O.  Test program.
+ * Usage: R20K ID [ID ...]   (tagged job ids of running R20X readers).  Waits R20K_WAIT ticks so the readers are in the
+ * middle of their reads (queued, active and waiting fills), then ends each named job with QT_JOB_KILL (0x2E). */
+#include <stdio.h>
+#include "qdos386.h"
+#define T_STAT 0x45u
+#define QT_SUSPEND_T 0x08u
+#define QT_JOB_KILL_T 0x2Eu
+#ifndef R20K_WAIT
+#define R20K_WAIT 300
+#endif
+int main(int argc, char **argv)
+{
+	int i, rc;
+	unsigned int id;
+
+	qtrap(QT_SUSPEND_T, (unsigned int) R20K_WAIT, 0u, 0u);
+	(void) qtrap(0x45u, 35u, 0u, 0u);      /* cache state at the moment of the kills (R20_STAT_DUMP) */
+	for (i = 1; i < argc; i++) {
+		id = (unsigned int) strtoul(argv[i], 0, 10);
+		rc = qtrap(QT_JOB_KILL_T, id, 0u, 0u);
+		printf("R20K kill id=%u rc=%d\n", id, rc);
+	}
+	return 0;
+}
diff --git a/tests/a16/r20x.c b/tests/a16/r20x.c
new file mode 100644
index 0000000..b802aef
--- /dev/null
+++ b/tests/a16/r20x.c
@@ -0,0 +1,77 @@
+/* R20X - Apollo 16 Phase 2B: bounded contention reader.  Test program, not a public API.
+ * Each reader performs R20X_N random 256-byte reads of WIN1:/PAT2.BIN (pinned to CPU 0), verifies every byte, and
+ * prints ONE summary line at the end (a single write, so concurrent readers cannot interleave inside a record):
+ *   R20X READER id=I expected=E ok=O short=S mismatch=M ioerr=X giveup=G status=DONE|INCOMPLETE
+ * ok      reads that returned 256 bytes (all verified)     short    reads that returned 1..255 bytes
+ * ioerr   reads that returned an error (negative)           giveup   GAVE_UP events charged to this job
+ * A reader that never reaches its summary line is a stall; the STARTUP dump (R20_STAT_DUMP) then shows the state.
+ */
+#include <stdio.h>
+#include "qdos386.h"
+
+#define T_SMP   0x3Eu
+#define T_STAT  0x45u
+#define T_TICKS 0x20u
+#define FILE_N  1572864ul
+#define NAME    "WIN1:/PAT2.BIN"
+#ifndef R20X_GIVEUP_IDX
+#define R20X_GIVEUP_IDX 34u      /* R20_STAT_MY_GIVEUP in the Phase 2B enum; 24u in the Phase 2A diagnostic copy */
+#endif
+
+#ifndef R20X_N
+#define R20X_N 200ul
+#endif
+
+static unsigned int pat(unsigned long i)
+{
+	return (unsigned int) (((i * 37ul) + ((i >> 8) * 11ul) + (i >> 16)) & 0xffu);
+}
+
+int main(void)
+{
+	unsigned char buf[QD_READ_MAX];
+	unsigned long seed, pos, k, ok = 0, shortr = 0, mismatch = 0, ioerr = 0, done = 0;
+	unsigned int id, j, giveup;
+	int ch, r;
+
+	id = (unsigned int) qd_self();
+	qtrap(T_SMP, 1u, id, 0u);
+	ch = qd_open(NAME);
+	if (ch <= 0) {
+		printf("R20X READER id=%u expected=%lu ok=0 short=0 mismatch=0 ioerr=0 giveup=0 status=OPENFAIL rc=%d\n",
+		       id, R20X_N, ch);
+		return 1;
+	}
+	seed = 4242ul + (unsigned long) id * 7919ul;
+	for (k = 0; k < R20X_N; k++) {
+		seed = (seed * 1103515245ul + 12345ul) & 0x7fffffffu;
+		pos = seed % FILE_N;
+		if (pos + QD_READ_MAX > FILE_N)
+			pos = FILE_N - QD_READ_MAX;
+		if (qd_seek(ch, pos) < 0) {
+			ioerr++;
+			done++;
+			continue;
+		}
+		r = qd_read(ch, buf, QD_READ_MAX);
+		done++;
+		if (r < 0) {
+			ioerr++;
+			continue;
+		}
+		if (r != QD_READ_MAX) {
+			shortr++;
+			continue;
+		}
+		ok++;
+		for (j = 0; j < (unsigned int) r; j++)
+			if (buf[j] != pat(pos + j))
+				mismatch++;
+	}
+	qd_close(ch);
+	giveup = (unsigned int) qtrap(T_STAT, R20X_GIVEUP_IDX, 0u, 0u);
+	(void) qtrap(T_TICKS, 0u, 0u, 0u);
+	printf("R20X READER id=%u expected=%lu completed=%lu ok=%lu short=%lu mismatch=%lu ioerr=%lu giveup=%u status=%s\n",
+	       id, R20X_N, done, ok, shortr, mismatch, ioerr, giveup, done == R20X_N ? "DONE" : "INCOMPLETE");
+	return mismatch == 0 && ioerr == 0 && shortr == 0 ? 0 : 1;
+}
