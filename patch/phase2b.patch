+
+def rows(path):
+    raw = open(path, "rb").read().replace(b"\x00", b"").decode("latin-1")
+    lines = sorted(set(l.strip() for l in raw.splitlines()))
+    passes, stats, prog = {}, {}, []
+    for l in lines:
+        m = PASS.search(l)
+        if m:
+            passes[int(m.group(2))] = m.groups()
+        m = STAT.search(l)
+        if m:
+            stats[int(m.group(2))] = m.groups()
+        m = PROG.search(l)
+        if m:
+            prog.append((int(m.group(1)), int(m.group(2))))
+    prog.sort(key=lambda x: x[1])
+    return passes, stats, prog
+
+def bg_rate(prog, t0, t1):
+    if t1 <= t0:
+        return None
+    inside = [c for c, t in prog if t0 <= t <= t1]
+    before = [c for c, t in prog if t <= t0]
+    if not inside:
+        return None
+    return (inside[-1] - (before[-1] if before else 0)) / float(t1 - t0)
+
+print("%-16s %-7s %4s %6s %5s %7s %7s %6s %6s %6s %6s %6s %6s" % (
+    "run", "work", "pass", "ticks", "bad", "hit", "miss", "fill", "coal", "evict", "nosp", "ide", "bg/tick"))
+for path in sorted(glob.glob(os.path.join(D, "*", "serial.txt"))):
+    tag = os.path.basename(os.path.dirname(path))
+    passes, stats, prog = rows(path)
+    if not passes:
+        print("%-16s NO RESULT" % tag)
+        continue
+    for p in sorted(passes):
+        what, pn, calls, nbytes, bad, t0, t1, ticks = passes[p]
+        st = stats.get(p)
+        g = (lambda i: st[i]) if st else (lambda i: "-")
+        bg = bg_rate(prog, int(t0), int(t1))
+        print("%-16s %-7s %4s %6s %5s %7s %7s %6s %6s %6s %6s %6s %6s" % (
+            tag, what, pn, ticks, bad,
+            g(2), g(3), g(4), g(6), g(7), g(8), g(9),
+            "%.0f" % bg if bg is not None else "-"))
diff --git a/scripts/a16-p2b-sysvol.sh b/scripts/a16-p2b-sysvol.sh
new file mode 100644
index 0000000..6401251
--- /dev/null
+++ b/scripts/a16-p2b-sysvol.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Apollo 16 Phase 2B test volume: a copy of BASE (BASE itself is not modified) with WIN1:/PAT2.BIN (1572864 bytes,
+# P(i) = (i*37 + (i>>8)*11 + (i>>16)) & 0xff) and the protected R20GS, R20GW, R20GL, R20C, R20P in /BIN.
+#   usage: sh scripts/a16-p2b-sysvol.sh OUT.img BASE.img
+set -eu
+ROOT=$(cd "$(dirname "$0")/.." && pwd); cd "$ROOT"; export MTOOLS_SKIP_CHECK=1
+OUT=${1:?}; BASE=${2:?}; cp "$BASE" "$OUT"
+T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+python3 -c "
+import sys
+open(sys.argv[1],'wb').write(bytes(((i*37)+((i>>8)*11)+(i>>16))&0xff for i in range(1572864)))" "$T/pat2.bin"
+mcopy -o -m -i "$OUT" "$T/pat2.bin" "::/PAT2.BIN"
+for p in R20GS R20GW R20GL R20C R20P; do
+	cp build/a16/${p}P.aout "$T/x"; touch -d '2026-10-31 08:00:00' "$T/x"; mcopy -o -m -i "$OUT" "$T/x" "::/BIN/$p.AOU"
+done
+fsck.fat -n "$OUT" > /dev/null
+echo "$OUT"
