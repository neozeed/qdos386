+import glob, os, re, sys
+
+D = sys.argv[1]
+PASS = re.compile(r"R20G (\w+) pass=(\d) calls=(\d+) bytes=(\d+) bad=(\d+) t0=(\d+) t1=(\d+) ticks=(\d+)")
