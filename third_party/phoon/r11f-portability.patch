@@ -1025,24 +1038,37 @@
 tm_to_time( struct tm* tmP )
     {
     time_t t;
+    long days, sod;
     static int monthtab[12] = {
 	0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334 };
 
+    /* QDOS/386: time_t is unsigned, so the day count is kept signed here and
+    ** negative results (years before 1970, day 0 of the epoch month) are
