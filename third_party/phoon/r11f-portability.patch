+    days = ( tmP->tm_year - 70 ) * 365;
+    /* Leap days for previous years.  (tm_year-69)/4 counts 2100 as a leap year,
+    ** but 2100 is divisible by 100 and not by 400, so it is not one.  Every year
+    ** from 2101 on therefore has one leap day too many, and one is taken off.
+    ** R11F correction; see docs/R11F-PHOON-PORT.md. */
+    days += ( tmP->tm_year - 69 ) / 4 - ( tmP->tm_year > 200 ? 1 : 0 );
