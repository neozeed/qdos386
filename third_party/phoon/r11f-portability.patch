-	++t;
+	++days;
     /* Days since the beginning of this month. */
-    t += tmP->tm_mday - 1;	/* 1-based field */
-    /* Hours, minutes, and seconds. */
-    t = t * 24 + tmP->tm_hour;
-    t = t * 60 + tmP->tm_min;
-    t = t * 60 + tmP->tm_sec;
+    days += tmP->tm_mday - 1;	/* 1-based field */
+    if ( days < 0 || days > 49710L )
+	return (time_t) -1;
+    /* Hours, minutes, and seconds, as the original's linear formula. */
+    sod = (long) tmP->tm_hour * 3600L + (long) tmP->tm_min * 60L + (long) tmP->tm_sec;
+    if ( sod < 0 || (unsigned long) sod > 0xFFFFFFFEUL - (unsigned long) days * 86400UL )
+	return (time_t) -1;
+    t = (time_t) ( (unsigned long) days * 86400UL + (unsigned long) sod );
 
     return t;
     }
