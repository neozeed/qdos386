--- /tmp/r11f-prev/prev/date_parse.c	2026-10-27 10:47:29.915482370 +0000
+++ b/date_parse.c	2026-10-27 10:47:23.487801650 +0000
@@ -1050,8 +1050,11 @@
 
     /* Years since epoch, converted to days. */
