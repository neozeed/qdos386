     }
     /* never defined: an array assignment, or a bare name, which is -12 */
+    if (next_is_op(lx, SB_OP_LPAR) && sb_arr_find(st, name, nlen) != NULL) {
+        return stmt_assign(st, lx);
+    }
+    {
